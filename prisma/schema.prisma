datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

enum UserRole {
  admin
  visitor
  student

  @@map("user_role")
}

enum VerificationStatus {
  pending
  approved
  rejected

  @@map("verification_status")
}

enum ProjectRepoType {
  frontend
  backend
  mobile
  monorepo

  @@map("project_repo_type")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role UserRole @default(visitor)

  githubUsername String? @map("github_username")
  linkedinUrl    String? @map("linkedin_url")

  hasBeenPrompted Boolean @default(false) @map("has_been_prompted")

  // relations
  student Student?

  reviewedVerificationRequests  VerificationRequest[] @relation("ReviewedVerificationRequests")
  requestedVerificationRequests VerificationRequest[] @relation("RequestedVerificationRequests")

  likes Like[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AcademicYear {
  id        String   @id @default(uuid())
  label     String   @unique // 2025-2026 for example
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectIdeas ProjectIdea[]

  @@map("academic_years")
}

model Subject {
  id        String @id @default(uuid())
  name      String @unique
  slug      String @unique
  yearLevel Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectIdeas ProjectIdea[]

  @@map("subjects")
}

model Student {
  id         String  @id @default(uuid())
  arabicName String  @map("arabic_name")
  userId     String? @unique @map("user_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  groups            Group[] // can be in multiple groups across different academic years and subjects
  user              User?         @relation(fields: [userId], references: [id])
  publishedProjects Project[]
  repos             ProjectRepo[]

  @@map("students")
}

model VerificationRequest {
  id String @id @default(uuid())

  userId       String  @map("user_id")
  reviewedById String? @map("reviewed_by_id")

  submittedArabicName String @map("submitted_arabic_name")
  collegeIdPicUrl     String @map("college_id_pic_url")

  status VerificationStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user       User  @relation("RequestedVerificationRequests", fields: [userId], references: [id])
  reviewedBy User? @relation("ReviewedVerificationRequests", fields: [reviewedById], references: [id])

  @@map("verification_requests")
}

model Group {
  id            String  @id @default(uuid())
  projectIdeaId String? @map("project_idea_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projectIdea ProjectIdea? @relation(fields: [projectIdeaId], references: [id])
  projects    Project[]
  students    Student[]

  @@map("groups")
}

model ProjectIdea {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups Group[]

  academicYearId String       @map("academic_year_id")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  subjectId String  @map("subject_id")
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@map("project_ideas")
}

model Project {
  id                 String   @id @default(uuid())
  name               String
  desc               String?
  groupId            String   @map("group_id")
  publisherStudentId String   @map("publisher_student_id")
  thumbnail          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  group      Group         @relation(fields: [groupId], references: [id])
  publisher  Student       @relation(fields: [publisherStudentId], references: [id])
  likes      Like[]
  previews   Preview[]
  repos      ProjectRepo[]
  categories Category[]
  tags       Tag[]

  @@map("projects")
}

model ProjectRepo {
  id        String          @id @default(uuid())
  type      ProjectRepoType
  projectId String          @map("project_id")
  url       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project      Project   @relation(fields: [projectId], references: [id])
  contributors Student[]

  @@map("project_repos")
}

model Like {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("likes")
}

model Preview {
  id        String   @id @default(uuid())
  url       String
  projectId String   @unique @map("project_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id])

  @@map("previews")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("tags")
}
